# VWE Webhook Server Environment Variables
# Kopieer dit naar .env en vul je eigen waarden in

# GitHub Configuration (VERPLICHT)
GITHUB_TOKEN=ghp_je_github_personal_access_token_hier
GITHUB_REPO=battletron1337gh/CarStoreCuijk
GITHUB_BRANCH=main

# Optioneel: Webhook secret voor extra beveiliging
# WEBHOOK_SECRET=je_geheime_webhook_key

# Optioneel: Data directories
# DATA_DIR=./data
# REPO_DIR=./repo

# Optioneel: Server poort (Render overschrijft dit meestal)
# PORT=3000
